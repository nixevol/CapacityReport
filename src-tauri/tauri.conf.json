{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapacityReport",
  "version": "3.0.0",
  "identifier": "com.nixevol.capacityreport",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CapacityReport",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/capareport-server"
    ],
    "resources": [
      "../Configure.json",
      "../ReportScript.sql"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerHooks": "./windows/nsis-hooks.nsh",
        "installMode": "perMachine",
        "languages": [
          "SimpChinese"
        ]
      }
    }
  }
}
